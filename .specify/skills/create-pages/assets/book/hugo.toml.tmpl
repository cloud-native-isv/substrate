# Hugo configuration for this project's documentation space — Hugo Book theme.
# Generated by create-pages (scaffold-hugo.py). docs/ is the Hugo project root AND
# the single content source: every content path is *mounted*, never copied, so the
# Markdown tree stays pure and no file is duplicated.
#
# Edit this file freely — only the managed block at the bottom (navigation + mounts)
# is regenerated.

baseURL = "/"
locale = "en"
title = "{{SITE_TITLE}}"

# Hugo Book (alex-shpak/hugo-book), vendored at themes/book by
#   scaffold-hugo.py --action theme --fetch
# The theme requires Hugo >= 0.158 (themes/book/theme.toml min_version).
theme = "book"

# Repo-native relative Markdown links (`../concepts/overview.md`) keep working on the
# rendered site: BookPortableLinks below makes the theme's link/image render hooks
# resolve each destination through Hugo's page graph, so no link rewriting is needed
# in the Markdown itself.
# relativeURLs keeps every generated URL relative, so the built site also works when
# hosted under a sub-path and when browsed straight off disk.
relativeURLs = true
disableKinds = ["taxonomy", "term", "RSS"]

[markup.goldmark.renderer]
  unsafe = true   # documentation legitimately contains raw HTML (<details>, <br>, badges)

[markup.highlight]
  noClasses = true   # self-contained styling; no chroma stylesheet to ship

[markup.tableOfContents]
  startLevel = 2
  endLevel = 3

[params]
  description = "{{SITE_DESCRIPTION}}"

  # Sidebar is built from the whole content tree ('*' == '/'), because this site's
  # content is mounted at content/<type> rather than under a single 'docs' section.
  BookSection = "*"
  # Resolve relative .md / image destinations silently. Set to "warning" for a link
  # audit run — expect noise, because documentation legitimately links to source
  # files outside the docs directory, which have no page on the site.
  BookPortableLinks = true
  BookTheme = "auto"      # follow the reader's light/dark preference
  BookSearch = true       # client-side search (fuse.js ships with the theme; no network)
  BookComments = false    # no third-party comment service on a docs site

{{MOUNTS}}
