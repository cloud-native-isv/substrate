# Hugo configuration for this project's documentation space.
# Generated by create-docs (scaffold-hugo.py). docs/ is the Hugo project root AND
# the single content source: every content path is *mounted*, never copied, so the
# Markdown tree stays pure and no file is duplicated.
#
# Edit this file freely — only the managed mount block at the bottom is regenerated.

baseURL = "/"
languageCode = "en"
title = "{{SITE_TITLE}}"

# Repo-native relative Markdown links (`../concepts/overview.md`) keep working on the
# rendered site because layouts/_default/_markup/render-link.html resolves each link
# through Hugo's page graph and emits the target's real URL — so the default pretty-URL
# scheme is kept, and no link rewriting is needed in the Markdown itself.
# relativeURLs keeps every generated URL relative, so the built site also works when
# hosted under a sub-path and when browsed straight off disk.
relativeURLs = true
disableKinds = ["taxonomy", "term", "RSS"]

[markup.goldmark.renderer]
  unsafe = true   # documentation legitimately contains raw HTML (<details>, <br>, badges)

[markup.highlight]
  noClasses = true   # self-contained styling; no chroma stylesheet to ship

[markup.tableOfContents]
  startLevel = 2
  endLevel = 3

[params]
  description = "{{SITE_DESCRIPTION}}"

{{MOUNTS}}
